# Copy to .env (git-ignored) and fill in. NEVER commit .env.
MQTT_HOST=
MQTT_PORT=8883          # TCP/TLS port for the alarm service + sniffer (not the websocket port)
MQTT_TLS=true
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=      # the "Topic Prefix" from the Afterburner comms page

# Admin login (set with tools/set-password.sh)
ADMIN_PASSWORD_HASH=
# Optional extra alert channel (ntfy topic URL), e.g. https://ntfy.sh/my-secret-topic
NTFY_URL=
# Recommended: a contact URL for the push service (mailto: or https:), e.g. https://heater.example.com
VAPID_SUBJECT=
COMMANDS_ENABLED=false   # set true only to let the portal publish heater commands
